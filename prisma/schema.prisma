// Prisma schema for Clip Matrix - Viral Clipping Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  name           String
  passwordHash   String
  role           String        @default("CLIPPER") // BRAND, CLIPPER, ADMIN
  status         String        @default("ACTIVE")  // ACTIVE, PENDING_VERIFICATION, SUSPENDED
  avatar         String?
  phone          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Profile relations
  brandProfile   BrandProfile?
  clipperProfile ClipperProfile?
  wallet         Wallet?
  
  // Relations
  campaignsCreated      Campaign[]              @relation("BrandCampaigns")
  campaignParticipations CampaignParticipation[]
  submissions           Submission[]            @relation("ClipperSubmissions")
  withdrawals           Withdrawal[]
  transactions          Transaction[]
  notifications         Notification[]
  supportTickets        SupportTicket[]
  auditLogs             AuditLog[]              @relation("AdminAuditLogs")
}

model BrandProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName  String
  industry     String   @default("Technology")
  companySize  String?  @default("11-50")
  website      String?
  logoUrl      String?
  isVerified   Boolean  @default(true)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ClipperProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramHandle String?
  youtubeHandle   String?
  tiktokHandle    String?
  portfolioUrl    String?
  editingSoftware String?  @default("CapCut, Premiere Pro")
  experienceYears String?  @default("1-3 years")
  preferredLangs  String?  @default("English, Hindi")
  upiId           String?
  bankName        String?
  bankAccountNumber String?
  bankIfsc        String?
  city            String?
  country         String   @default("India")
  isVerified      Boolean  @default(true)
  level           String   @default("PRO_CLIPPER") // ROOKIE, PRO_CLIPPER, ELITE, MASTER
  rating          Float    @default(4.9)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Campaign {
  id                  String   @id @default(uuid())
  title               String
  slug                String   @unique
  brandId             String
  brand               User     @relation("BrandCampaigns", fields: [brandId], references: [id], onDelete: Cascade)
  industry            String   @default("Tech & AI")
  description         String
  objective           String   @default("Drive awareness and signups for viral launch")
  
  // Media Assets & Guidelines
  sourceVideoUrl      String?  // Main long-form video URL (YouTube, Vimeo, etc.)
  driveAssetsUrl      String?  // Google drive / Dropbox link for raw assets
  rawVideoDownloadUrl String?  // Direct downloadable file
  thumbnailUrl        String?
  guidelines          String   // Creative rules & instructions
  hookSuggestions     String?  // e.g. "Use first 3 seconds hook: Stop scrolling..."
  prohibitedContent   String?  // e.g. "No misleading claims, keep original tone"
  requiredHashtags    String   @default("#viral #ad #trending")
  allowedPlatforms    String   @default("INSTAGRAM,YOUTUBE,TIKTOK") // Comma-separated
  
  // Specs
  minDurationSec      Int      @default(15)
  maxDurationSec      Int      @default(60)
  aspectRatio         String   @default("9:16")
  
  // Rewards & Budget
  rewardModel         String   @default("CPM") // CPM, FIXED, MILESTONE, HYBRID
  rewardPerClip       Float    @default(500)   // For FIXED model (₹)
  cpmRate             Float    @default(120)   // For CPM model (₹ per 1,000 verified views)
  milestoneRulesJson  String?  // For MILESTONE model: JSON e.g. [{"views":10000,"reward":500},...]
  maxRewardPerClip    Float    @default(15000) // Cap to protect budget
  totalBudget         Float    @default(50000)
  remainingBudget     Float    @default(50000)
  targetViews         Int      @default(500000)
  verifiedViews       Int      @default(0)
  
  // Status
  status              String   @default("ACTIVE") // DRAFT, PENDING_APPROVAL, ACTIVE, PAUSED, COMPLETED, CANCELLED
  isFeatured          Boolean  @default(false)
  deadline            DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  participations      CampaignParticipation[]
  submissions         Submission[]
}

model CampaignParticipation {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clipperId  String
  clipper    User     @relation(fields: [clipperId], references: [id], onDelete: Cascade)
  status     String   @default("ACTIVE") // ACTIVE, SUBMITTED, COMPLETED
  joinedAt   DateTime @default(now())

  @@unique([campaignId, clipperId])
}

model Submission {
  id                String         @id @default(uuid())
  submissionNumber  String         @unique // e.g. "CLM-SUB-1042"
  campaignId        String
  campaign          Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clipperId         String
  clipper           User           @relation("ClipperSubmissions", fields: [clipperId], references: [id], onDelete: Cascade)
  
  platform          String         // INSTAGRAM, YOUTUBE, TIKTOK
  videoUrl          String         // Live social media post URL
  title             String
  caption           String?
  postAccountHandle String?
  thumbnailUrl      String?
  submissionNotes   String?
  
  // Performance & Verification
  reportedViews     Int            @default(0)
  verifiedViews     Int            @default(0)
  likesCount        Int            @default(0)
  commentsCount     Int            @default(0)
  sharesCount       Int            @default(0)
  
  // Financials
  rewardEarned      Float          @default(0)
  isPaid            Boolean        @default(false)
  
  // Status
  status            String         @default("PENDING_REVIEW") // PENDING_REVIEW, UNDER_REVIEW, APPROVED, REJECTED, VIEWS_VERIFIED, PAID
  rejectionReason   String?
  reviewNotes       String?
  
  submittedAt       DateTime       @default(now())
  reviewedAt        DateTime?
  verifiedAt        DateTime?
  paidAt            DateTime?

  viewSnapshots     ViewSnapshot[]
}

model ViewSnapshot {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  viewCount    Int
  likes        Int        @default(0)
  comments     Int        @default(0)
  shares       Int        @default(0)
  verifiedBy   String     @default("API_SYNC") // API_SYNC, MANUAL_AUDIT, ADMIN
  notes        String?
  timestamp    DateTime   @default(now())
}

model Wallet {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Float         @default(0)       // Available withdrawable/spendable
  pendingBalance Float         @default(0)       // Pending review / unverified views
  escrowBalance  Float         @default(0)       // Brand locked escrow for campaigns
  lifetimeEarned Float         @default(0)       // Clippers
  lifetimeSpent  Float         @default(0)       // Brands
  updatedAt      DateTime      @updatedAt

  transactions   Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   // DEPOSIT, CAMPAIGN_ESCROW_LOCK, REWARD_CREDIT, WITHDRAWAL, REFUND, PLATFORM_COMMISSION
  status      String   @default("COMPLETED") // PENDING, COMPLETED, FAILED, CANCELLED
  description String
  referenceId String?  // submissionId, campaignId, withdrawalId
  createdAt   DateTime @default(now())
}

model Withdrawal {
  id             String    @id @default(uuid())
  clipperId      String
  clipper        User      @relation(fields: [clipperId], references: [id], onDelete: Cascade)
  amount         Float
  method         String    @default("UPI") // UPI, BANK_TRANSFER
  accountDetails String    // UPI ID or Account Number + IFSC
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED, PROCESSED
  payoutTxnId    String?
  adminNotes     String?
  requestedAt    DateTime  @default(now())
  processedAt    DateTime?
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // CAMPAIGN, SUBMISSION, REWARD, WITHDRAWAL, SYSTEM
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String   @default("GENERAL") // PAYMENT, CAMPAIGN, SUBMISSION, ACCOUNT, TECHNICAL
  priority  String   @default("NORMAL")  // LOW, NORMAL, HIGH, URGENT
  status    String   @default("OPEN")    // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  message   String
  response  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action    String   // e.g. "APPROVE_CAMPAIGN", "VERIFY_VIEWS", "APPROVE_WITHDRAWAL"
  entity    String   // "Campaign", "Submission", "Withdrawal", "User"
  entityId  String
  details   String
  ipAddress String?  @default("127.0.0.1")
  createdAt DateTime @default(now())
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL") // GENERAL, FINANCIAL, VERIFICATION
  description String?
  updatedAt   DateTime @updatedAt
}
